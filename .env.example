# Credenciales de Google OAuth para el stack local (supabase start).
# Copia este archivo a .env y completa los valores de Google Cloud Console.
# NUNCA subas el archivo .env a git.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
